{
  "name": "vektorlab",
  "private": true,
  "version": "0.1.0",
  "description": "Analisi strutturale 2D interattiva - telai piani",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "analyze": "tsx cli/analyze.ts",
    "baseline:write": "tsx strumenti/baseline.ts --scrivi",
    "baseline:check": "tsx strumenti/baseline.ts",
    "pdf-check": "tsx strumenti/pdfCheck.ts",
    "screenshots": "tsx strumenti/screenshots.ts",
    "foto:attesi": "tsx strumenti/foto/scriviAttesi.ts",
    "foto:campagna": "tsx strumenti/foto/campagna.ts",
    "foto:valuta": "tsx strumenti/foto/valuta.ts",
    "foto:telefono": "tsx strumenti/foto/provaTelefono.ts"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "pdfjs-dist": "^6.3.289",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "onnxruntime-web": "1.30.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.2"
  },
  "engines": {
    "node": "22.x"
  }
}
